---
import Layout from "../../layouts/Layout.astro";
import FeaturedShowcase from "../../components/FeaturedShowcase.astro";
import { getCollection } from "astro:content";
import fs from "fs";
import path from "path";
const projects = await getCollection("projects");
const sortedProjects = projects.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
let featured = sortedProjects.slice(0, 3);
try {
  const settings = JSON.parse(fs.readFileSync(path.join(process.cwd(), "src/content/settings/homepage.json"), "utf-8"));
  const selected = (settings.featuredProjects as string[]).map((slug) => projects.find((project) => project.slug === slug)).filter(Boolean);
  if (selected.length) featured = selected;
} catch {}
const hero = featured[0]?.data.mainImage;
const heroImage = typeof hero === "string" ? hero : "/uploads/IMG_1882.jpeg";
---
<Layout locale="en" title="Pastry chef · restaurant desserts" description="I am Florent Dabert, a pastry chef in training specialising in restaurant desserts and seasonal creations.">
  <section class="mx-auto grid max-w-7xl gap-10 px-4 pb-16 pt-12 sm:px-6 md:grid-cols-[1.05fr_.95fr] md:items-center md:py-22 lg:px-8"><div class="order-2 md:order-1"><p class="eyebrow">Pastry chef · Poitiers · France</p><h1 class="mt-5 max-w-xl font-serif text-5xl leading-[.95] tracking-tight text-stone-950 sm:text-6xl lg:text-7xl">I want dessert to become <em class="font-normal text-amber-800">the lasting memory.</em></h1><p class="mt-6 max-w-lg text-lg leading-relaxed text-stone-600">I create restaurant desserts, entremets and seasonal pastries. This portfolio grows alongside my training and professional experience.</p><div class="mt-8 flex flex-wrap gap-3"><a class="button-primary" href="#selection">Explore my selection</a><a class="button-secondary" href="/en/journey">Discover my journey</a></div></div><div class="order-1 overflow-hidden rounded-[2rem] bg-stone-200 shadow-[0_24px_60px_rgb(60,42,25,0.2)] md:order-2"><img src={heroImage} alt={featured[0]?.data.titleEn || featured[0]?.data.title || "Florent Dabert pastry creation"} class="aspect-[4/5] h-full w-full object-cover" fetchpriority="high" /></div></section>
  <section id="selection" class="border-y border-stone-200 bg-[#f4ede2]"><div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8"><p class="eyebrow">Selected work</p><h2 class="mt-2 font-serif text-4xl text-stone-950">My featured creations</h2><p class="mb-8 mt-3 max-w-xl text-sm leading-relaxed text-stone-600">Swipe the selection on mobile to discover the work I have chosen to feature.</p><FeaturedShowcase projects={featured} locale="en" /></div></section>
  <section class="mx-auto grid max-w-7xl gap-8 px-4 py-16 sm:px-6 md:grid-cols-3 lg:px-8"><div><p class="eyebrow">My journey in motion</p><h2 class="mt-3 font-serif text-3xl text-stone-950">Learn, create, travel.</h2></div><p class="text-stone-600">I am currently completing a specialist certificate in restaurant desserts at Campus 120. I am developing a precise pastry style designed for the plate, with the ambition to continue my journey internationally.</p><a href="/en/contact" class="button-primary self-start md:justify-self-end">Contact me</a></section>
</Layout>
