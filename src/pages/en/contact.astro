---
import Layout from "../../layouts/Layout.astro";
import { Mail, Phone, MapPin } from "lucide-astro";
---
<Layout locale="en" title="Contact" description="Contact Florent Dabert, pastry chef based in Poitiers, France.">
  <section class="mx-auto max-w-5xl px-4 py-14 sm:px-6 md:py-22 lg:px-8"><p class="eyebrow">Contact</p><h1 class="mt-4 max-w-2xl font-serif text-5xl leading-[.98] text-stone-950 md:text-6xl">Let’s talk about a <em class="font-normal text-amber-800">dessert project.</em></h1><div class="mt-12 grid gap-5 md:grid-cols-3"><a href="mailto:flodab86@gmail.com" class="rounded-3xl bg-white p-6 shadow-[0_8px_30px_rgb(55,42,25,0.08)]"><Mail class="size-6 text-amber-800" /><p class="mt-8 text-sm text-stone-500">Email</p><strong class="mt-1 block text-stone-950">flodab86@gmail.com</strong></a><a href="tel:+33652230227" class="rounded-3xl bg-white p-6 shadow-[0_8px_30px_rgb(55,42,25,0.08)]"><Phone class="size-6 text-amber-800" /><p class="mt-8 text-sm text-stone-500">Phone</p><strong class="mt-1 block text-stone-950">+33 6 52 23 02 27</strong></a><div class="rounded-3xl bg-stone-900 p-6 text-white"><MapPin class="size-6 text-[#f3c880]" /><p class="mt-8 text-sm text-stone-300">Based in</p><strong class="mt-1 block">Poitiers, France</strong></div></div></section>
</Layout>
