---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import type { Locale } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
}

const { title, description = "Portfolio de Florent Dabert, pâtissier spécialisé en desserts de restaurant.", locale = "fr" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternate = locale === "fr" ? new URL(`/en${Astro.url.pathname === "/" ? "/" : Astro.url.pathname}`, Astro.site) : new URL(Astro.url.pathname.replace(/^\/en/, "") || "/", Astro.site);
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- SEO Principal -->
    <title>{title} | Florent Dabert</title>
    <meta
      name="description"
      content={description}
    />
    <meta
      name="keywords"
      content="Florent Dabert, pâtissier, pâtisserie, Poitiers, Vienne, 86, stage pâtisserie, restauration, desserts maison, entremets, gâteaux artisanaux, desserts professionnels, pâtisserie française, créations sucrées, chef pâtissier"
    />
    <meta name="author" content="Florent Dabert" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang={locale === "fr" ? "en" : "fr"} href={alternate} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={locale === "fr" ? "fr_FR" : "en_GB"} />
    <meta property="og:site_name" content="Florent Dabert Pâtisserie" />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <!-- Géolocalisation -->
    <meta name="geo.region" content="FR-86" />
    <meta name="geo.placename" content="Poitiers" />
    <meta name="geo.position" content="46.580224;0.340375" />
    <meta name="ICBM" content="46.580224, 0.340375" />
    
    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Florent Dabert",
        "jobTitle": "Pâtissier",
        "description": "Pâtissier professionnel spécialisé dans les créations artisanales, entremets et desserts maison",
        "url": "https://florentdabert.bessastien.fr",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Poitiers",
          "addressRegion": "Nouvelle-Aquitaine",
          "postalCode": "86000",
          "addressCountry": "FR"
        },
        "knowsAbout": [
          "Pâtisserie",
          "Entremets",
          "Desserts maison",
          "Restauration",
          "Stage pâtisserie"
        ],
        "sameAs": []
      }
    </script>

    <!-- Fonts: Playfair Display (Serif) & DM Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap"
      rel="stylesheet"
    />

  </head>
  <body class="bg-[#fbf8f3] text-stone-800 font-sans min-h-screen flex flex-col">
    <Navbar locale={locale} />
    <main class="flex-grow w-full">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>

<style is:global>
  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-family: "Playfair Display", serif;
  }
</style>
