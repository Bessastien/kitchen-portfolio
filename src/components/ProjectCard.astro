---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { href, labels, projectTitle, type Locale } from "../lib/site";

interface Props {
  project: CollectionEntry<"projects">;
  locale?: Locale;
}

const { project, locale = "fr" } = Astro.props;
const mainImage = project.data.mainImage;
const isImageString = typeof mainImage === "string";
const title = projectTitle(project, locale);
const origin = project.data.origin;
---

<a
  href={href(locale, `/projects/${project.slug}`)}
  class="group block overflow-hidden rounded-3xl bg-white shadow-[0_8px_30px_rgb(55,42,25,0.08)] transition duration-300 hover:-translate-y-1 hover:shadow-[0_20px_40px_rgb(55,42,25,0.16)]"
>
  <div class="aspect-[4/5] w-full overflow-hidden bg-stone-100">
    {
      isImageString ? (
        <img
          src={mainImage}
          alt={title}
          class="object-cover w-full h-full transition duration-700 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <Image
          src={mainImage}
          alt={title}
          width={800}
          height={1000}
          class="object-cover w-full h-full transition duration-700 group-hover:scale-105"
        />
      )
    }
  </div>

  <div class="p-5">
    {origin && <span class="mb-3 inline-flex rounded-full bg-amber-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.13em] text-amber-900">{labels[locale].origin[origin]}</span>}
    <h3 class="font-serif text-2xl leading-tight text-stone-950">{title}</h3>
    {project.data.tags.length > 0 && <p class="mt-2 text-sm text-stone-500">{project.data.tags.slice(0, 3).join(" · ")}</p>}
  </div>
</a>
