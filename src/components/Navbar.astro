---
import { Globe, Menu, X } from "lucide-astro";
import { href, labels, type Locale } from "../lib/site";
import ProfileMark from "./ProfileMark";

interface Props { locale?: Locale; }
const { locale = "fr" } = Astro.props;
const t = labels[locale];
const otherLocale: Locale = locale === "fr" ? "en" : "fr";
const switchTo = locale === "fr" ? `/en${Astro.url.pathname === "/" ? "/" : Astro.url.pathname}` : Astro.url.pathname.replace(/^\/en/, "") || "/";
---

<nav class="sticky top-0 z-50 border-b border-stone-200/70 bg-[#fbf8f3]/90 backdrop-blur-xl">
  <div class="mx-auto flex h-18 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href={href(locale)} class="group flex items-center gap-3" aria-label="Florent Dabert">
      <ProfileMark client:load />
      <span class="leading-none"><strong class="block font-serif text-lg tracking-tight text-stone-950">Florent Dabert</strong><small class="text-[10px] font-semibold uppercase tracking-[0.16em] text-amber-800">Pâtissier</small></span>
    </a>
    <div class="hidden items-center gap-7 md:flex">
      <a href={href(locale)} class="nav-link">{t.home}</a><a href={href(locale, "/projects")} class="nav-link">{t.creations}</a><a href={href(locale, "/journey")} class="nav-link">{t.journey}</a><a href={href(locale, "/contact")} class="nav-link">{t.contact}</a>
      <a href={switchTo} lang={otherLocale} class="inline-flex items-center gap-1 rounded-full border border-stone-300 px-3 py-2 text-xs font-bold uppercase tracking-wider text-stone-700"><Globe class="size-3.5" /> {otherLocale}</a>
    </div>
    <details class="relative md:hidden"><summary class="grid size-11 cursor-pointer place-items-center rounded-full border border-stone-300 text-stone-900 marker:content-none" aria-label={t.menu}><Menu class="size-5 open:hidden" /><X class="hidden size-5 open:block" /></summary><div class="absolute right-0 top-13 w-64 rounded-2xl border border-stone-200 bg-[#fffdf9] p-3 shadow-2xl"><a href={href(locale)} class="mobile-link">{t.home}</a><a href={href(locale, "/projects")} class="mobile-link">{t.creations}</a><a href={href(locale, "/journey")} class="mobile-link">{t.journey}</a><a href={href(locale, "/contact")} class="mobile-link">{t.contact}</a><a href={switchTo} lang={otherLocale} class="mobile-link mt-2 border-t border-stone-100 pt-3"><Globe class="size-4" /> {otherLocale === "en" ? "English" : "Français"}</a></div></details>
  </div>
</nav>
